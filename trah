#!/usr/bin/env python3
"""`claude trah` — одна дверь: и первая установка, и обновление.

    ./trah                  поставить или обновить всё, что нужно этой машине
    ./trah --check          ничего не записывать, показать что изменилось бы
    ./trah status           что стоит: версия, сборка, комплект, обёртка
    ./trah inventory        опись чужой машины: что уже есть и с чем столкнёмся
    ./trah project ПУТЬ     проектный уровень: скелет брифа, правил и docs/
    ./trah tests            все наборы проверок комплекта
    ./trah --version 2.1.263    целиться в эту версию, а не в новейшую

ЗАЧЕМ ОДНА ДВЕРЬ
===============

Входов было три, и какой из них когда звать, знал только тот, кто их писал:
`install-kit.py` раскладывал комплект, `trah.py build` собирал патченую копию,
а порядок между ними жил в `deploy` из соседнего репозитория — который ушёл в
архив вместе с ним. Установка «с нуля» и обновление отличались не сутью, а тем,
какие из трёх команд человек вспомнит.

Здесь этот порядок записан один раз, и он одинаков для пустой машины и для
машины, где комплект уже стоит: шаги идемпотентны, каждый сам решает, есть ли
ему что делать. Поэтому отдельной команды «установить» нет — она бы отличалась
от «обновить» только тем, что первый раз всё делается впервые.

ПОРЯДОК И ПОЧЕМУ ОН ТАКОЙ
=========================

    1. комплект   — хуки, навыки, агенты, бриф, реестр модулей в `~/.claude`;
    2. serena     — Serena на коммите из `serena/upstream.txt` и с нашими патчами;
    3. сборка     — патченая копия бинарника под нужную версию;
    4. обёртка    — точка входа `~/.local/bin/claude`.

Комплект раньше сборки: сборка читает куски из комплекта и кладёт рядом манифест,
а хук восстановления обёртки читает памятку `~/.claude/trah-kit-path`, которую
пишет установка. Обёртка последней: она запускает то, что собрано двумя шагами
выше, и ставить её раньше значило бы на время оставить точку входа указывающей
в пустоту.

Сами шаги никуда не делись — этот файл их зовёт, а не переписывает. Хочешь один
шаг, зови его отсюда по имени; хочешь понять, что он делает, открой тот скрипт.
"""
import argparse
import json
import subprocess
import sys
from pathlib import Path

КОРЕНЬ = Path(__file__).resolve().parent
КОМПЛЕКТ = КОРЕНЬ / "trah-setup"
ДОМ_СБОРОК = Path.home() / ".local/share/claude"
ПИН = КОМПЛЕКТ / "version.txt"


class Ход:
    """Что произошло, чтобы сказать это в конце одним куском."""

    def __init__(self, всухую: bool) -> None:
        self.всухую = всухую
        self.сделано: list[str] = []
        self.провалено: list[str] = []
        self.руками: list[str] = []


def выполнить(ход: Ход, имя: str, команда: list, ввод: str | None = None) -> bool:
    print(f"\n\033[1m── {имя}\033[0m\n   " + " ".join(str(к) for к in команда))
    г = subprocess.run(команда, cwd=КОРЕНЬ, input=ввод, text=True)
    if г.returncode == 0:
        ход.сделано.append(имя)
        return True
    ход.провалено.append(f"{имя} (код {г.returncode})")
    return False


def ключ_версии(имя: str) -> tuple:
    """Номер версии числами: `sort -V` строкой ставит 2.1.9 после 2.1.10."""
    return tuple(int(ч) if ч.isdigit() else -1 for ч in имя.split("."))


def версии_на_машине() -> list[str]:
    каталог = ДОМ_СБОРОК / "versions"
    if not каталог.is_dir():
        return []
    return sorted((п.name for п in каталог.iterdir() if п.is_file()),
                  key=ключ_версии)


def прицел() -> str:
    return ПИН.read_text(encoding="utf-8").strip() if ПИН.exists() else ""


def собрана(версия: str) -> bool:
    return (ДОМ_СБОРОК / "trah" / версия).is_file()


def шаг_комплект(ход: Ход) -> None:
    команда = [sys.executable, str(КОМПЛЕКТ / "bin/install-kit.py")]
    if ход.всухую:
        команда.append("--dry-run")
    выполнить(ход, "комплект: ~/.claude", команда)


def шаг_сборка(ход: Ход, цель: str | None) -> None:
    """Собрать патченую копию — или переехать на другую версию целиком.

    Разница между «собрать» и «переехать» не в усилии, а в том, меняется ли
    ПРИЦЕЛ. Прицел (`version.txt`) переписывает только `upgrade`, и только
    после того, как сверка якорей, сборка, проверка доставки и все наборы
    проверок прошли. Поэтому обновление версии Claude Code идёт этой дорогой, а
    не «собрать заново с новым номером».
    """
    доступные = версии_на_машине()
    if not доступные:
        ход.провалено.append(f"сборка: в {ДОМ_СБОРОК / 'versions'} нет ни одной версии")
        return
    нужна = цель or доступные[-1]
    свой = прицел()

    if нужна not in доступные:
        ход.провалено.append(f"сборка: версии {нужна} нет в {ДОМ_СБОРОК / 'versions'}")
        return

    if нужна == свой and собрана(нужна):
        print(f"\n\033[1m── сборка\033[0m\n   {нужна} уже собрана — нечего делать")
        ход.сделано.append(f"сборка: {нужна} уже на месте")
        return

    if ход.всухую:
        что = ("переезд" if нужна != свой else "сборка") + f" {свой or '—'} → {нужна}"
        выполнить(ход, f"сверка якорей ({что}, ничего не пишу)",
                  [sys.executable, str(КОМПЛЕКТ / "bin/trah.py"), "check", нужна])
        return

    if нужна != свой:
        выполнить(ход, f"переезд {свой or '—'} → {нужна}",
                  [sys.executable, str(КОМПЛЕКТ / "bin/trah.py"), "upgrade", нужна])
    else:
        выполнить(ход, f"сборка {нужна}",
                  [sys.executable, str(КОМПЛЕКТ / "bin/trah.py"), "build", нужна])


def шаг_серена(ход: Ход) -> None:
    """Serena на прицеле комплекта и с его патчами.

    Нет Serena — ставится прицел. Стоит прицел — доналагаются недостающие патчи.
    Стоит ДРУГОЙ коммит — не трогается: переезд Serena это решение, и оно
    называется в докладе командой, а не делается попутно.
    """
    скрипт = КОМПЛЕКТ / "bin/serena-patch.py"
    г = subprocess.run([sys.executable, str(скрипт), "stamp"], capture_output=True, text=True)
    стоит, свой = (г.stdout.split() + ["", ""])[:2]
    if стоит not in ("", "нет") and стоит != свой:
        ход.руками.append(f"serena: стоит {стоит[:12]}, прицел {свой[:12]} — "
                          f"python3 {скрипт} upgrade {свой}")
        return
    выполнить(ход, "serena: прицел и патчи",
              [sys.executable, str(скрипт), "install", *(["--check"] if ход.всухую else [])])


def шаг_обёртка(ход: Ход) -> None:
    """Точка входа `~/.local/bin/claude`.

    Ставит её тот же код, что чинит её после обновления Claude Code, — хук
    `restore-claude-wrapper.py`. Второго установщика обёртки нет намеренно: две
    редакции одного действия разъезжаются молча, а цена расхождения здесь —
    сессия без брифа, которая выглядит совершенно обычной.
    """
    if ход.всухую:
        ход.руками.append("обёртка: показать нечего — хук ставит её сам, "
                          "запусти без --check")
        return
    выполнить(ход, "обёртка: ~/.local/bin/claude",
              [sys.executable, str(КОМПЛЕКТ / "hooks/restore-claude-wrapper.py")],
              ввод=json.dumps({"hook_event_name": "SessionStart"}))


def status() -> int:
    доступные = версии_на_машине()
    свой = прицел()
    print(f"\033[1mclaude trah\033[0m   комплект: {КОМПЛЕКТ}")
    print(f"  прицел (version.txt):  {свой or '—'}")
    print(f"  новейшая на машине:    {доступные[-1] if доступные else '—'}"
          + ("" if not доступные or доступные[-1] == свой else "   ← есть куда переезжать"))
    print(f"  патченая копия:        "
          + (f"есть ({ДОМ_СБОРОК / 'trah' / свой})" if свой and собрана(свой) else "НЕТ"))
    указатель = ДОМ_СБОРОК / "trah/current"
    if указатель.is_symlink():
        print(f"  current →              {указатель.resolve().name}")
    памятка = Path.home() / ".claude/trah-kit-path"
    print(f"  памятка о комплекте:   "
          + (памятка.read_text(encoding='utf-8').strip() if памятка.exists() else "НЕТ"))
    точка = Path.home() / ".local/bin/claude"
    вид = "нет"
    if точка.is_symlink():
        вид = f"симлинк → {точка.resolve().name} (обёртки НЕТ)"
    elif точка.is_file():
        вид = ("обёртка" if "GWS-CLAUDE-WRAPPER" in
               точка.read_text(encoding="utf-8", errors="replace")[:4096] else "чужой файл")
    print(f"  точка входа:           {вид}")
    return 0


def доклад(ход: Ход) -> int:
    print("\n" + "─" * 70)
    for имя, список, знак in (("СДЕЛАНО", ход.сделано, "✓"),
                              ("ПРОВАЛИЛОСЬ", ход.провалено, "✗"),
                              ("ДАЛЬШЕ РУКАМИ", ход.руками, "•")):
        if список:
            print(f"{имя}:")
            for с in список:
                print(f"  {знак} {с}")
    if not ход.провалено and not ход.всухую:
        print("Сессии, поднятые раньше, работают на прежней сборке — перезапусти их.")
    if ход.всухую:
        print("Это был показ. Ничего не записано. Повторить без --check.")
    print("─" * 70)
    return 1 if ход.провалено else 0


def main() -> int:
    р = argparse.ArgumentParser(
        description="поставить или обновить `claude trah`",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    р.add_argument("команда", nargs="?", default="all",
                   choices=["all", "status", "tests", "inventory", "project"],
                   help="без аргумента — поставить или обновить всё")
    р.add_argument("--check", action="store_true",
                   help="ничего не записывать, показать что изменилось бы")
    р.add_argument("--version", dest="версия",
                   help="целиться в эту версию Claude Code, а не в новейшую")
    # `parse_known_args`, а не `parse_args`: у `project` есть свой аргумент —
    # каталог, — и он принадлежит не этой двери, а инструменту за ней.
    # Разбирать чужие аргументы здесь значило бы держать их описание в двух
    # местах.
    а, лишнее = р.parse_known_args()
    if лишнее and а.команда != "project":
        р.error(f"unrecognized arguments: {' '.join(лишнее)}")

    if а.команда == "status":
        return status()
    if а.команда == "project":
        # Проектный уровень: скелет в рабочем каталоге. Существующее не
        # трогается; без --write только показывает.
        return subprocess.run(
            [sys.executable, str(КОМПЛЕКТ / "bin/init-project.py"), *sys.argv[2:]],
            cwd=КОРЕНЬ).returncode
    if а.команда == "inventory":
        # Опись стоит ПЕРЕД установкой, а не после: она отвечает на вопрос
        # «чьё здесь что» и ничего не пишет на диск.
        return subprocess.run(
            [sys.executable, str(КОМПЛЕКТ / "bin/inventory.py"), *sys.argv[2:]],
            cwd=КОРЕНЬ).returncode
    if а.команда == "tests":
        return subprocess.run(
            [sys.executable, str(КОМПЛЕКТ / "bin/trah.py"), "tests"],
            cwd=КОРЕНЬ).returncode

    ход = Ход(а.check)
    print(f"\033[1mclaude trah → {Path.home()}\033[0m"
          + ("   (показ, ничего не пишу)" if а.check else ""))
    шаг_комплект(ход)
    шаг_серена(ход)
    шаг_сборка(ход, а.версия)
    шаг_обёртка(ход)
    return доклад(ход)


if __name__ == "__main__":
    # Иначе наши заголовки уезжают в буфер, а вывод подпроцессов идёт мимо него
    # прямо в терминал: отчёт получается в обратном порядке и читать его нельзя.
    sys.stdout.reconfigure(line_buffering=True)
    sys.exit(main())
