#!/usr/bin/env bash
# GWS-CLAUDE-WRAPPER — маркер: по нему хук узнаёт свою обёртку среди чужих файлов.
#
# Обёртка над настоящим `claude`: подаёт правила экосистемы системным промптом
# через --append-system-prompt-file и передаёт управление настоящему бинарю.
#
# ЗАЧЕМ. Текст правил в CLAUDE.md попадает в тот же блок кэша, что и задание,
# и пересоздаётся каждую сессию. Тот же текст под --append-system-prompt-file
# ложится в кэшируемую часть: замер 20.08.2026 — плюс к прочитанному и ровно
# ноль к созданному. Чтение стоит 0,1× входа, запись в кэш — 2×, то есть
# двадцатикратная разница в цене за один и тот же текст.
#
# ГЛАВНОЕ ПРАВИЛО: обёртка НИКОГДА не мешает claude запуститься. Любая
# неясность — не нашли бриф, файл пуст или нечитаем, версия не знает флага,
# пользователь сам управляет системным промптом — означает «запустить настоящий
# бинарь БЕЗ флага». Потерять экономию дешевле, чем сломать инструмент.
#
# Установка и починка после обновления — hooks/restore-claude-wrapper.py.

WRAPPER_SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
SHARE_DIR="${HOME:-/root}/.local/share/claude"
PIN_FILE="$SHARE_DIR/wrapper-pin"
CACHE_DIR="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/gws-claude-wrapper"

# Подкоманды: у них свой разбор аргументов, и корневой флаг там либо лишний,
# либо опасен. `claude update` и `claude install` — путь обновления самого
# инструмента, ронять его нельзя ни при каких обстоятельствах.
# Сверено с `claude --help` версии 2.1.236.
SUBCOMMANDS=" agents auth auto-mode doctor gateway import install mcp plugin plugins project setup-token ultrareview update upgrade "

# ── 1. Настоящий бинарь ──────────────────────────────────────────────────────
#
# Симлинк ~/.local/bin/claude обёртка собой заменила, значит цель выбираем сами.
# Порядок и обоснование:
#   1) CLAUDE_WRAPPER_TARGET — явное указание: тесты и ручной обход;
#   2) закрепка `wrapper-pin` — версия, выбранная РУКАМИ. Обычно её нет. Нужна,
#      когда свежая версия сломана и надо посидеть на старой:
#        echo ~/.local/share/claude/versions/2.1.233 > ~/.local/share/claude/wrapper-pin
#      Снять закрепку — удалить файл;
#   3) новейшая по номеру версия в ~/.local/share/claude/versions — обычный путь.
#      Сортировка `sort -V`, а не по времени: время правится `touch`, номер — нет;
#   4) любой другой claude в PATH, кроме себя, — на случай, если раскладка
#      установки изменилась целиком.
#
# ПОЧЕМУ НЕ ПАМЯТКА, ПРОВЕРЕНО ФАКТОМ 21.08.2026. До этого дня первым стоял файл
# `wrapper-target`, куда хук записывал цель симлинка В МОМЕНТ замены его
# обёрткой. Рассуждение было такое: обновление пересоздаёт симлинк, хук ловит
# этот момент и переписывает памятку свежей целью. Оно неверно. Установщик
# Claude Code видит, что точка входа — не симлинк, и НЕ ТРОГАЕТ её («was not
# created by the native installer … auto-update leaves it untouched»), а хук при
# живой обёртке выходит сразу. Значит момент, в который памятка переписывается,
# не наступает больше никогда: запись от 20.08 указывала на 2.1.236, а 2.1.237 и
# 2.1.238 лежали рядом скачанные и ни разу не запущенные. `claude update` при
# этом рапортовал успех — он и правда обновлял, просто не то, что запускается.
#
# Отсюда правило: по умолчанию запускается САМАЯ СВЕЖАЯ версия, потому что
# именно это имел в виду тот, кто позвал `claude update`. Отступление от
# умолчания — только явным действием человека, и оно видно файлом.
resolve_binary() {
    local candidate dir

    if [ -n "${CLAUDE_WRAPPER_TARGET:-}" ] && usable "$CLAUDE_WRAPPER_TARGET"; then
        printf '%s' "$CLAUDE_WRAPPER_TARGET"; return 0
    fi

    if [ -r "$PIN_FILE" ]; then
        candidate=$(head -n 1 "$PIN_FILE" 2>/dev/null)
        if usable "$candidate"; then printf '%s' "$candidate"; return 0; fi
    fi

    if [ -d "$SHARE_DIR/versions" ]; then
        candidate=$(ls -1 "$SHARE_DIR/versions" 2>/dev/null | sort -V | tail -n 1)
        if [ -n "$candidate" ] && usable "$SHARE_DIR/versions/$candidate"; then
            printf '%s' "$SHARE_DIR/versions/$candidate"; return 0
        fi
    fi

    local saved_ifs="$IFS"
    IFS=':'
    for dir in ${PATH:-}; do
        IFS="$saved_ifs"
        [ -n "$dir" ] || continue
        if usable "$dir/claude"; then printf '%s' "$dir/claude"; IFS="$saved_ifs"; return 0; fi
        IFS=':'
    done
    IFS="$saved_ifs"
    return 1
}

# Годен, если это исполняемый обычный файл и это НЕ мы сами: запуск себя
# зациклился бы навсегда.
usable() {
    [ -n "${1:-}" ] || return 1
    [ -f "$1" ] && [ -x "$1" ] || return 1
    [ "$(readlink -f "$1" 2>/dev/null)" != "$WRAPPER_SELF" ]
}

# ── 2. Стоит ли вообще добавлять флаг ────────────────────────────────────────
#
# Отказ в безопасную сторону. Разбирать чужие аргументы всерьёз мы не беремся:
# достаточно одного совпадения, чтобы отойти в сторону.
#
#   --append-system-prompt[-file] — ПРОВЕРЕНО ПРОБОЙ на 2.1.236: вместе с нашим
#     флагом CLI отказывается стартовать («Cannot use both … Please use only
#     one»). Таусозавр передаёт --append-system-prompt в режиме ультракода, так
#     что безусловное добавление роняло бы каждую такую сессию. Сливать наш
#     бриф с чужим текстом НЕ пробуем: это разбор чужих аргументов, где цена
#     ошибки — не запустившийся claude, а выигрыш частный.
#   --system-prompt[-file] — claude подменяет промпт целиком и наш флаг
#     игнорирует. Вреда бы не было, но и пользы тоже; молча ничего не делать
#     честнее, чем передавать флаг, который заведомо ни на что не влияет.
#   служебные вызовы — у --version и --help разбор короткий и до опций дело не
#     доходит, но список держим явным: он читается как правило, а не как
#     наблюдение за текущей версией.
#   --bare — намеренно голый режим, он и CLAUDE.md не читает. Подсовывать ему
#     правила значило бы отменять решение того, кто этот режим выбрал.
wants_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --system-prompt*|--append-system-prompt*) return 1 ;;
            -h|--help|-v|--version|--bare) return 1 ;;
        esac
        case "$SUBCOMMANDS" in *" $arg "*) return 1 ;; esac
    done
    return 0
}

# Бриф подагента — отдельный вопрос с тем же отказом в безопасную сторону.
# Свой флаг у вызывающего (`--append-subagent-system-prompt[-file]`) — отходим:
# вдвоём с нашим CLI не стартует («Cannot use both … Please use only one»).
# `--system-prompt` главного подагентов не касается и нам не помеха.
wants_subagent_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --append-subagent-system-prompt*) return 1 ;;
            -h|--help|-v|--version|--bare) return 1 ;;
        esac
        case "$SUBCOMMANDS" in *" $arg "*) return 1 ;; esac
    done
    return 0
}

# ── 3. Файл правил ───────────────────────────────────────────────────────────
#
# Проектный: ближайший .claude/brief.md вверх от текущего каталога до корня.
find_project_brief() {
    local dir="${PWD:-$(pwd 2>/dev/null)}"
    [ -n "$dir" ] || return 1
    while :; do
        # ДОМ — НЕ ПРОЕКТ, и подъём на нём обрывается. `$HOME/.claude/brief.md`
        # это ГЛОБАЛЬНЫЙ бриф: он уже подан как GLOBAL_BRIEF. Подобрать его ещё
        # и проектным значит склеить два брифа в один системный промпт.
        #
        # В обычном режиме это гасила проверка `"$GLOBAL_BRIEF" != "$PROJECT_BRIEF"`
        # ниже: пути совпадали. В режиме `trah` глобальный — ДРУГОЙ файл
        # (`brief-trah.md`), пути расходятся, и защита пропускала.
        #
        # Обмер 28.08.2026: склейка 29 554 байта при глобальном брифе в 14 193 —
        # домашний бриф целиком вторым куском, ~3800 лишних токенов КАЖДЫМ ходом.
        # И хуже денег: две независимо написанные редакции одной дисциплины
        # разошлись — один текст утверждал потолок в 32 одновременных вызова,
        # другой рядом «there is no artificial ceiling».
        #
        # Третий случай «дом принят за корень» после `e8a4b9b`.
        if [ -n "${HOME:-}" ] && [ "$dir" = "$HOME" ]; then
            return 1
        fi
        if readable_brief "$dir/.claude/brief.md"; then
            printf '%s' "$dir/.claude/brief.md"; return 0
        fi
        [ "$dir" = "/" ] && return 1
        dir=$(dirname "$dir" 2>/dev/null) || return 1
        [ -n "$dir" ] || return 1
    done
}

# Пустой файл — тоже отказ: флаг с пустым содержимым ничего не даёт, а лишний
# аргумент в командной строке путает того, кто будет разбираться в проблеме.
readable_brief() {
    [ -f "${1:-}" ] && [ -r "$1" ] && [ -s "$1" ]
}

# Два --append-system-prompt-file подряд НЕ складываются — ПРОВЕРЕНО ПРОБОЙ
# 20.08.2026: побеждает последний, содержимое первого до модели не доходит,
# и молча. Поэтому глобальные и проектные правила склеиваем в один файл.
#
# Имя склейки — от размеров и времён обоих исходников. Это важно не для
# опрятности, а для кэша: одинаковое содержимое должно давать один и тот же
# файл, иначе каждый запуск пересоздавал бы кэш и экономия обнулилась бы.
# Глобальные правила идут ПЕРВЫМИ: они одни на все проекты, и такой порядок
# даёт общий префикс кэша для сессий в разных каталогах, а проектное правило
# оказывается ниже и при расхождении читается как уточнение.
merge_briefs() {
    local global="$1" project="$2" key merged tmp
    key=$(printf '%s\n' "$global" "$project" \
              "$(stat -c '%s %Y' "$global" 2>/dev/null)" \
              "$(stat -c '%s %Y' "$project" 2>/dev/null)" \
          | md5sum 2>/dev/null | cut -d ' ' -f 1)
    [ -n "$key" ] || return 1
    merged="$CACHE_DIR/brief-$key.md"
    [ -s "$merged" ] && { printf '%s' "$merged"; return 0; }
    mkdir -p "$CACHE_DIR" 2>/dev/null || return 1
    tmp="$merged.part.$$"
    { cat "$global" && printf '\n\n' && cat "$project"; } > "$tmp" 2>/dev/null || return 1
    mv -f "$tmp" "$merged" 2>/dev/null || return 1
    printf '%s' "$merged"
}

# ── 4. Знает ли эта версия про флаг ──────────────────────────────────────────
#
# Незнакомый флаг для claude — не предупреждение, а отказ стартовать
# («error: unknown option»). Поэтому спрашиваем сам бинарь, а не догадываемся
# по номеру версии.
#
# Проба: подкоманда `mcp` без аргументов печатает свою справку, никуда не
# ходит и укладывается в ~0,16 с, но разбор корневых опций до неё доходит —
# неизвестная опция даёт «unknown option» на stderr. Вердикт кладём в кэш по
# размеру и времени бинаря, так что платим за пробу один раз на версию.
flag_supported() {
    local bin="$1" flag="${2:---append-system-prompt-file}"
    local sig cache cached_sig cached_verdict verdict err timeout_cmd=""
    sig=$(stat -c '%s-%Y' "$bin" 2>/dev/null) || return 1
    [ -n "$sig" ] || return 1
    cache="$CACHE_DIR/flag-$(printf '%s %s' "$bin" "$flag" | md5sum 2>/dev/null | cut -d ' ' -f 1)"
    if [ -r "$cache" ]; then
        read -r cached_sig cached_verdict < "$cache" 2>/dev/null
        if [ "$cached_sig" = "$sig" ]; then
            [ "$cached_verdict" = "yes" ]; return
        fi
    fi
    command -v timeout >/dev/null 2>&1 && timeout_cmd="timeout 20"
    # stdin пробе закрываем ОБЯЗАТЕЛЬНО.
    #
    # Без `</dev/null` проба наследует терминал сессии, лезет в него и получает
    # `SIGTTIN` — процесс встаёт в состояние `T`, а обёртка ждёт его молча.
    # Снаружи это выглядит как «claude запустился и висит, непонятно чего ждёт».
    # Поймано 26.08.2026 сразу после пересборки патча: вердикт пробы кэшируется
    # по подписи бинаря, пересборка её сменила, кэш протух — и проба пошла
    # заново, впервые из живого терминала.
    err=$($timeout_cmd "$bin" "$flag" /dev/null mcp </dev/null 2>&1 >/dev/null)
    # «unknown option» — единственный ответ, который значит «не поддерживает».
    # Пропала подкоманда mcp, проба не запустилась, вывод пуст — всё это НЕ
    # доказывает отсутствия флага, и выдавать их за доказательство нельзя.
    case "$err" in
        *"unknown option"*) verdict="no" ;;
        *)                  verdict="yes" ;;
    esac
    mkdir -p "$CACHE_DIR" 2>/dev/null \
        && printf '%s %s\n' "$sig" "$verdict" > "$cache" 2>/dev/null
    [ "$verdict" = "yes" ]
}

# ── 4.5. Режим `claude trah` ─────────────────────────────────────────────────
#
# Интерактивная сессия на патченой сборке, со своим брифом и своей Сереной.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ РЕЖИМ. Патченая копия несёт правки системных промптов —
# сжатие, снаряжение подагента, дисциплина инструментов, — и до сих пор её
# получали только безголовые сессии. Человеку за терминалом доставалась
# штатная сборка и общий бриф, написанный для службы: с чекпоинтами, приказами
# и летописью, которых в интерактиве нет вовсе.
#
# ТРИ ОТЛИЧИЯ ОТ ОБЫЧНОГО ЗАПУСКА, и каждое — переключатель, а не новый код:
#   1) бинарь — патченая копия (через тот же CLAUDE_WRAPPER_TARGET, который
#      обёртка уже умеет разрешать первым приоритетом);
#   2) бриф НЕ отличается: `~/.claude/brief.md` один на оба режима, проектный
#      `.claude/brief.md` подмешивается тем же `merge_briefs`, что и всегда;
#   3) Серена поднимается СВОЯ, привязанная к корню текущего проекта.
#
# ПОЧЕМУ СВОЯ СЕРЕНА. Общий сервер держит один проект на всех, и сессия из
# чужого каталога получает символьный слой не от того дерева. Хуже того,
# активированный домашний каталог заставляет её обходить кэши, хранилище
# пакетов и исходники ядра — минуты на ровном месте. Здесь корень вычисляется
# от текущего каталога и передаётся явно.
#
# ОТКАЗ В БЕЗОПАСНУЮ СТОРОНУ, как и везде в этой обёртке: нет патченой копии —
# идём на штатной и говорим об этом; нет Серены в PATH — идём без неё.
# Корень проекта Серены для текущего каталога.
#
# ПОЧЕМУ НЕ ПРОСТО git-КОРЕНЬ. Память Серены лежит в `<проект>/.serena/memories`,
# и проект Серены далеко не всегда совпадает с репозиторием. Проверено фактом
# 26.08.2026: у `SyncedProjects/.serena/memories` шестнадцать файлов, а каждый
# бот внутри — ОТДЕЛЬНАЯ git-репа без своей `.serena`. Правило «git-корень»
# на любом боте привязало бы Серену к нему и потеряло всю память разом, молча:
# `list_memories` ответил бы пустотой, и это выглядело бы как «памяти нет».
#
# Поэтому спрашиваем сверху вниз:
#   1) ближайший предок с `.serena/project.yml` — это и есть проект Серены;
#   2) корень репозитория — для проекта, который Сереной ещё не размечен;
#   3) текущий каталог — когда нет ни того, ни другого.
#
# ГРАНИЦА ПОДЪЁМА — домашний каталог. У него тоже есть `.serena/project.yml`,
# и без этой границы каталог без собственной разметки уводил бы Серену в `~`,
# а там она обходит кэши, хранилище пакетов и исходники ядра — минуты на ровном
# месте. Домашний каталог берётся, только если работаем прямо в нём.
trah_project_root() {
    local dir="${PWD:-$(pwd 2>/dev/null)}" d git_root
    [ -n "$dir" ] || return 1

    d="$dir"
    while [ -n "$d" ]; do
        # Дом проверяется ПЕРВЫМ, до метки. У него метка есть — он зарегистрирован
        # в Serena проектом «kaltsit», — но проектом он от этого не становится:
        # `language_servers: []`, пустой `ignored_paths`, и привязка к нему значит
        # обход кэшей и исходников ядра без символьного слоя взамен.
        [ "$d" = "${HOME:-/}" ] && break
        [ "$d" = "/" ] && break
        if [ -f "$d/.serena/project.yml" ]; then printf '%s' "$d"; return 0; fi
        d=$(dirname "$d" 2>/dev/null) || break
    done

    git_root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$git_root" ] && [ -d "$git_root" ] && [ "$git_root" != "${HOME:-}" ]; then
        printf '%s' "$git_root"; return 0
    fi

    # Ни размеченного проекта, ни репозитория — привязывать не к чему.
    #
    # Сюда попадают домашний каталог и разовые сессии в `~/что-нибудь`: сложить
    # там задачу, посмотреть конфиг, разобрать архив. Привязка Серены к такому
    # каталогу — худшее из возможного: у домашнего проекта `language_servers: []`
    # и пустой `ignored_paths`, то есть символьного слоя нет, зато есть обход
    # кэшей, хранилища пакетов и исходников ядра на минуты.
    #
    # Пустой ответ значит «подними Серену БЕЗ проекта»: инструменты доступны,
    # и если работа окажется про конкретный репозиторий — его активируют явно.
    return 1
}

# Конфиг Серены под этот корень. Имя файла от корня, а не случайное:
# одинаковый каталог должен давать один и тот же файл, иначе каждый запуск
# плодил бы мусор в кэше.
#
# Транспорт stdio, а не общий сервер по сети: процесс живёт ровно столько,
# сколько сессия, и умирает вместе с ней. Один каталог — один сервер, спорить
# за него некому. Подагенты идут через то же соединение: сервер поднимает CLI,
# а подагент работает внутри того же процесса CLI, своего сервера не заводит.
#
# `--project` передаётся при запуске, поэтому проект активен СРАЗУ: звать
# `activate_project` не нужно и вредно — это лишний ход и лишний шанс
# промахнуться каталогом.
#
# `--strict-mcp-config` НЕ передаётся намеренно: он отменил бы все остальные
# серверы из настроек человека, и наш конфиг из помощника стал бы ограничителем.
trah_mcp_config() {
    local root key args
    command -v serena >/dev/null 2>&1 || return 1

    if root=$(trah_project_root) && [ -n "$root" ] && [ -d "$root" ]; then
        key=$(printf '%s' "$root" | md5sum 2>/dev/null | cut -d ' ' -f 1)
        args='"--project","'"$root"'",'
        # Корень называем ХУКУ явно, переменной. Спросить об этом больше некого:
        # панель нашего сервера выключена ниже (`--enable-web-dashboard false`),
        # и опрос портов отвечает сервером ЧУЖОЙ сессии.
        export TRAH_SERENA_PROJECT="$root"
        printf 'claude trah: Серена на %s\n' "$root" >&2
    else
        # Проекта нет — сервер поднимается без привязки. Ничего не индексируется
        # до тех пор, пока проект не назовут явно.
        key="noproject"
        args=""
        unset TRAH_SERENA_PROJECT
        printf 'claude trah: проекта нет — Серена без привязки; понадобится символьная работа, активируйте нужный проект явно\n' >&2
    fi

    [ -n "$key" ] || return 1
    mkdir -p "$CACHE_DIR/mcp" 2>/dev/null || return 1
    TRAH_MCP="$CACHE_DIR/mcp/serena-$key.json"
    if [ ! -s "$TRAH_MCP" ]; then
        printf '{"mcpServers":{"serena":{"command":"serena","args":["start-mcp-server","--context","claude-code",%s"--enable-web-dashboard","false"]}}}\n' \
            "$args" > "$TRAH_MCP" 2>/dev/null || return 1
    fi
    return 0
}

TRAH_MODE=0
GLOBAL_BRIEF_FILE="${HOME:-}/.claude/brief.md"
# Бриф подагента. `--append-system-prompt-file` меняет промпт ТОЛЬКО главного:
# замер 29.09.2026 — из 114 подагентов за две недели 23 сами открывали бриф
# по указке заглушки CLAUDE.md, в том числе бриф главного с его персоной, и
# 70 ходов ушли на отказы гардов, о которых подагенту никто не сказал. Флаг
# подагента дописывает файл каждому подагенту, встроенным тоже. Справка CLI
# обещает его только с --print; проба 29.09.2026 на 2.1.280 показала, что
# stream-json без --print (так запускает VS Code) его тоже доносит. В TUI
# флаг принимается без ошибки, доходит ли — не проверено.
AGENT_BRIEF_FILE="${HOME:-}/.claude/agent-brief.md"
TRAH_ARGS=()

# Ищем `trah` не только первым словом.
#
# ПОЧЕМУ НЕ `$1`. Перед обёрткой может стоять чужая: у владельца в fish живёт
# функция `claude`, которая подставляет свой флаг ПЕРЕД аргументами, и до нас
# приходит `--allow-dangerously-skip-permissions trah`. Проверка первого слова
# в таком случае не срабатывает молча, а `trah` уезжает в сессию текстом
# сообщения — ровно это и случилось 26.08.2026.
#
# ПРАВИЛО. Пропускаем ведущие флаги (всё, что начинается с `-`) и смотрим на
# первое НЕ-флаговое слово. Оно `trah` — это режим, снимаем его. Оно любое
# другое — это задача или подкоманда, режима нет.
#
# Ограничение сознательное: флаг со ЗНАЧЕНИЕМ через пробел (`--model opus trah`)
# собьёт разбор, потому что `opus` встанет первым не-флаговым словом. Разбирать
# чужие аргументы всерьёз мы не беремся — это правило всей обёртки. Пишите
# `claude trah --model opus`, а не наоборот.
TRAH_WORD=0
if [ "$#" -gt 0 ]; then
    _seen=0
    for _a in "$@"; do
        case "$_a" in
            -*) continue ;;
            trah) TRAH_WORD=1; break ;;
            *) _seen=1; break ;;
        esac
    done
    unset _a _seen
fi

if [ "$TRAH_WORD" = 1 ]; then
    # Снимаем `trah` из аргументов, где бы он ни стоял среди ведущих флагов.
    _rest=""
    set -- "$@"
    _out=""
    _dropped=0
    for _a in "$@"; do
        if [ "$_dropped" = 0 ] && [ "$_a" = "trah" ]; then _dropped=1; continue; fi
        _out="$_out $(printf '%s' "$_a" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")"
    done
    eval "set -- $_out"
    unset _a _out _dropped _rest

    TRAH_MODE=1
    # Бриф здесь НЕ подменяется: он один на оба режима, `~/.claude/brief.md`.
    #
    # До 28.08.2026 режим брал свой `brief-trah.md`, и брифов было два: редакция
    # службы и редакция режима. Они писались порознь и разошлись — один текст
    # утверждал потолок в 32 одновременных вызова, другой рядом «there is no
    # artificial ceiling»; ценные разделы оказались только в одной из двух.
    # Плюс заглушки `~/.claude/CLAUDE.md` и `rules/mcp-discipline.md` посылали
    # читать `brief.md`, то есть НЕ ту редакцию, что лежала в промпте.
    #
    # Теперь `~/.claude/brief.md` — это бриф режима, а редакция службы
    # законсервирована рядом как `brief-zavr.md` и в сессии не подаётся.

    if usable "$SHARE_DIR/trah/current"; then
        CLAUDE_WRAPPER_TARGET="$SHARE_DIR/trah/current"
        export CLAUDE_WRAPPER_TARGET
    else
        printf '%s\n' \
            "claude trah: патченой сборки нет ($SHARE_DIR/trah/current) — запускаю штатную" >&2
    fi

    # Разделы `# Delivering work` и `# Corrections` — принудительно.
    #
    # Оба штатные, текст Anthropic, и оба закрыты вентилем: сборщик промпта
    # включает их по `opus_5_prompt_bundle` модели или по признаку
    # `tengu_bison_cairn`/`tengu_larch_cistern`, а решает это СЕРВЕР. 12.09.2026
    # поимка живой сессии `claude trah` через прокси: без переменных промпт
    # 31 814 байт и обоих разделов нет, с переменными — 35 608 байт и оба на
    # месте. В кэше `~/.claude.json` у сервера стояло `tengu_bison_cairn = false`.
    # Без раздела молча не работает кусок `sys-delivering-work-at-full-scope`:
    # он вставляется в текст раздела.
    #
    # Заданное снаружи значение не трогаем: `=0` выключает раздел на один запуск.
    : "${CLAUDE_CODE_BISON_CAIRN:=1}" "${CLAUDE_CODE_LARCH_CISTERN:=1}"
    export CLAUDE_CODE_BISON_CAIRN CLAUDE_CODE_LARCH_CISTERN

    trah_mcp_config && TRAH_ARGS+=(--mcp-config "$TRAH_MCP")

    # Разрешающий флаг — как у службы.
    #
    # Он не «разрешает больше, чем список allow», он отменяет саму проверку:
    # `permissions.allow` из настроек перестаёт что-либо значить, потому что
    # спрашивать не будут ни о чём. Решение владельца и осознанное: режим
    # заводился для работы, а не для диалога о правах.
    #
    # Второе, ради чего он нужен: без него `bypassPermissions` нельзя включить
    # на живой сессии — CLI отвечает отказом «session was not launched with
    # --dangerously-skip-permissions».
    #
    # Снять на один запуск нечем — уберите слово `trah` и запускайте обычным
    # `claude`, там всё как было.
    # Второй раз не добавляем: у владельца в fish функция `claude` уже
    # подставляет свой флаг разрешений, и два флага об одном — в лучшем случае
    # шум, в худшем отказ разбора.
    case " $* " in
        *" --dangerously-skip-permissions "*|*" --allow-dangerously-skip-permissions "*) ;;
        *) TRAH_ARGS+=(--dangerously-skip-permissions) ;;
    esac
fi

# Дисциплина инструментов — принуждением, а не уговором, и во ВСЕХ сессиях.
#
# Хук `nudge-serena.py` по умолчанию предупреждает: чтение проектного файла
# через `cat`/`sed` проходит, а в ответ приезжает укор. Укор читается уже ПОСЛЕ
# того, как весь вывод лёг в контекст, то есть платить за промах всё равно
# приходится.
#
# До 30.08.2026 значение ставилось только в ветке `claude trah`, и это мерилось:
# у соседней сессии в `SyncedProjects` переменной не было вовсе, её подагент
# спокойно прочитал `internal/api/relist_handlers.go` через `command grep`, а
# проигрыш той же команды с `block` даёт отказ. То есть в обычных сессиях гард
# был косметикой. Теперь он один для обоих контуров.
#
# Радиус ограничен самим хуком: он срабатывает только на файлы под своими
# корнями (по умолчанию `~/Ledevia`), в чужом дереве сессия его не заметит.
#
# Значение уважает заданное снаружи — `NUDGE_SERENA_MODE=warn claude …` вернёт
# мягкий режим на один запуск, ничего не правя.
: "${NUDGE_SERENA_MODE:=block}"
export NUDGE_SERENA_MODE

# Потолок батчинга — тоже ВСЕМ сессиям.
#
# В CLI зашито `CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY ?? 10`: больше десяти
# вызовов одновременно не уйдёт, сколько ни проси. Десять — это ровно тот
# предел, об который бьётся символьная работа: разведка по проекту складывается
# из полутора десятков независимых запросов, и резать её на два хода значит
# заново переслать весь контекст ради второй половины.
#
# До 30.08.2026 значение стояло только в ветке `claude trah`, а комментарий
# рядом обещал «два контура должны вести себя одинаково, иначе замер, снятый в
# одном, ничего не говорит о другом». Обещание было ложным: у обычной сессии
# оставались зашитые десять, то есть втрое уже. Замеры ширины батча, снятые в
# одном контуре, к другому не относились.
#
# Значение уважает заданное снаружи — как и режим гарда выше.
: "${CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY:=32}"
export CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY

# Режим виден хукам, а не только этой обёртке.
#
# Диспетчер `pretooluse.py` читает два реестра модулей: свой и чужой
# (`modules.local.json`, модули соседних продуктов). В режиме `trah` чужой не
# читается: сессия режима не подчиняется правилам продукта, с которым она не
# работает. Отличить режим хук может единственным способом — по этой
# переменной, поэтому она экспортируется ВСЕГДА, и в обычной сессии тоже: ноль
# значит «читай оба», отсутствие значения значило бы то же самое, но молча.
export TRAH_MODE

# ── 5. Запуск ────────────────────────────────────────────────────────────────
BIN=$(resolve_binary) || BIN=""
if [ -z "$BIN" ]; then
    printf '%s\n' "claude: не найден настоящий бинарь (искала в $PIN_FILE, $SHARE_DIR/versions и PATH)" >&2
    exit 127
fi

PROJECT_BRIEF=$(find_project_brief) || PROJECT_BRIEF=""
EXTRA_ARGS=()

if wants_flag "$@"; then
    GLOBAL_BRIEF=""
    readable_brief "$GLOBAL_BRIEF_FILE" && GLOBAL_BRIEF="$GLOBAL_BRIEF_FILE"

    BRIEF=""
    if [ -n "$GLOBAL_BRIEF" ] && [ -n "$PROJECT_BRIEF" ] && [ "$GLOBAL_BRIEF" != "$PROJECT_BRIEF" ]; then
        # Склейка не вышла — берём проектный: он ближе к делу, чем глобальный.
        BRIEF=$(merge_briefs "$GLOBAL_BRIEF" "$PROJECT_BRIEF") || BRIEF="$PROJECT_BRIEF"
        [ -n "$BRIEF" ] || BRIEF="$PROJECT_BRIEF"
    elif [ -n "$PROJECT_BRIEF" ]; then
        BRIEF="$PROJECT_BRIEF"
    elif [ -n "$GLOBAL_BRIEF" ]; then
        BRIEF="$GLOBAL_BRIEF"
    fi

    if [ -n "$BRIEF" ] && flag_supported "$BIN"; then
        EXTRA_ARGS+=(--append-system-prompt-file "$BRIEF")
    fi
fi

# Подагенту — его бриф и бриф каталога за ним: правила каталога (дух работы,
# когда можно собирать) касаются и того, кто работает по поручению.
if wants_subagent_flag "$@" && readable_brief "$AGENT_BRIEF_FILE" \
        && flag_supported "$BIN" --append-subagent-system-prompt-file; then
    SUB_BRIEF="$AGENT_BRIEF_FILE"
    if [ -n "$PROJECT_BRIEF" ]; then
        SUB_BRIEF=$(merge_briefs "$AGENT_BRIEF_FILE" "$PROJECT_BRIEF") || SUB_BRIEF="$AGENT_BRIEF_FILE"
        [ -n "$SUB_BRIEF" ] || SUB_BRIEF="$AGENT_BRIEF_FILE"
    fi
    EXTRA_ARGS+=(--append-subagent-system-prompt-file "$SUB_BRIEF")
fi

exec "$BIN" "${TRAH_ARGS[@]}" "${EXTRA_ARGS[@]}" "$@"
